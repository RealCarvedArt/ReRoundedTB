<ui:FluentWindow x:Class="RoundedTB.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoundedTB"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="#20808080"
        Title="ReRoundedTB - About" Height="616" Width="500"
        Visibility ="Visible" ResizeMode="NoResize" Opacity="1.001">
    <Grid>

        <Image x:Name="bannerMst" Visibility ="Visible" HorizontalAlignment="Center" Height="128" VerticalAlignment="Top"  Opacity="0.8" Source="res\HeadBanner.png" Width="500" Stretch="UniformToFill" Margin="0,-16,0,0"/>
        <Image x:Name="bannerDev" Visibility ="Hidden" HorizontalAlignment="Center" Height="128" VerticalAlignment="Top"  Opacity="0.8" Source="res\HeadBannerDev.png" Width="500" Stretch="UniformToFill" Margin="0,-16,0,0"/>
        <Image x:Name="bannerCan" Visibility ="Hidden" HorizontalAlignment="Center" Height="146" VerticalAlignment="Top"  Opacity="0.8" Source="res\HeadBannerCan.png" Width="500" Stretch="UniformToFill" Margin="0,-16,0,0"/>
        <Button x:Name="okButton" Content="OK" Margin="0,0,10,10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="85" Click="okButton_Click" FontWeight="Normal"/>
        <TextBlock x:Name="titleBlock" HorizontalAlignment="Left" Margin="10,35,0,0" TextWrapping="Wrap" Text="Welcome to ReRoundedTB!" VerticalAlignment="Top" FontWeight="Normal" FontFamily="Segoe UI Semibold" FontSize="36" Opacity="0.795"/>
        <TextBlock x:Name="subtitleBlock" HorizontalAlignment="Left" Margin="10,85,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" FontWeight="Normal" FontFamily="Segoe UI Semibold" FontSize="22" Opacity="0.795" Height="30"/>

        <ui:TitleBar x:Name="aboutTitleBar" Grid.Row="0" Title="ReRoundedTB - About" Height="51" ShowMaximize="False" VerticalAlignment="Top">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/RoundedTB.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>


        <TextBlock x:Name="bodyBlockMain" Margin="10,134,10,0" TextWrapping="Wrap" FontWeight="Normal" FontFamily="Segoe UI SemiBold" FontSize="14" Height="37" VerticalAlignment="Top">
            <Bold>Thanks for downloading ReRoundedTB. Expand the following categories for more information.</Bold>
        </TextBlock>

        <ScrollViewer Margin="0,176,0,0" VerticalScrollBarVisibility="Auto" Height="378" VerticalAlignment="Top">
            <StackPanel Width="473">
                <Expander x:Name="expander0" Header="What's new" HorizontalAlignment="Center" VerticalAlignment="Top" Width="480" FontSize="16" FontFamily="Segoe UI Semibold">
                    <Grid>
                        <TextBlock Margin="0,5,0,0" x:Name="bodyBlock0" TextWrapping="Wrap" FontWeight="Normal" FontFamily="Segoe UI" FontSize="14" Opacity="0.8" LineHeight="23">
                    <Bold>• 3.7.2:</Bold> Pause and Reset in the tray menu; the tray icon comes back after Explorer restarts; full keyboard and screen-reader support, and readable contrast in light and dark mode.
                    <LineBreak/>
                    <Bold>• 3.7.1:</Bold> dynamic mode no longer gets stuck showing only a few icons after Windows rebuilds the taskbar (e.g. after sleep or a display change).
                    <LineBreak/>
                    <Bold>• New name:</Bold> RoundedTB is now ReRoundedTB, a maintained fork. Your settings carry over.
                    <LineBreak/>
                    <Bold>• Dynamic mode fixed on current Windows 11:</Bold> the taskbar resizes to fit all its icons again, on every monitor.
                    <LineBreak/>
                    <Bold>• Stability:</Bold> fixes for the taskbar going square over time, the app silently stopping, and taskbars not being reshaped after Explorer restarts.
                    <LineBreak/>
                    <Bold>• Runs on .NET 10</Bold>, with known-vulnerable and unused components removed.
                    <LineBreak/>
                    <Bold>• Closing the settings window</Bold> hides ReRoundedTB to the tray; left-click the tray icon to reopen it.
                        </TextBlock>
                    </Grid>
                </Expander>
                <Expander x:Name="expander1" Header="About basic options" HorizontalAlignment="Center" VerticalAlignment="Top" Width="480" FontSize="16" FontFamily="Segoe UI Semibold">
                    <Grid>
                        <TextBlock Margin="0,5,0,0" x:Name="bodyBlock1" TextWrapping="Wrap" FontWeight="Normal" FontFamily="Segoe UI" FontSize="14" Opacity="0.8" LineHeight="23">
                    <Bold>• Taskbar segments</Bold> - click a segment in the preview to edit it. Without dynamic mode the whole taskbar is one segment.
                    <LineBreak/>
                    <Bold>• Corner radius</Bold> - how rounded the selected segment's corners are.
                    <LineBreak/>
                    <Bold>• Top, bottom, left and right margin</Bold> - how many pixels to trim from each side of the selected segment. The trimmed area is see-through and click-through.
                    <LineBreak/>
                    <Bold>• Apply</Bold> - applies and saves your changes.
                    <LineBreak/>
                    <Bold>• Help</Bold> - opens this window.
                        </TextBlock>
                    </Grid>
                </Expander>
                <Expander x:Name="expander2" Header="About advanced options" HorizontalAlignment="Center" VerticalAlignment="Top" Width="480" FontSize="16" FontFamily="Segoe UI Semibold">
                    <Grid>
                        <TextBlock Margin="0,5,0,0" x:Name="bodyBlock2" TextWrapping="Wrap" FontWeight="Normal" FontFamily="Segoe UI" FontSize="14" Opacity="0.8" LineHeight="23">
                    <Bold>• Dynamic mode (Windows 11)</Bold> - shrinks the taskbar to fit its icons, like a dock. The app list, the system tray and, when the taskbar is centered, the widgets area become separate segments.
                    <LineBreak/>
                    <Bold>• Split mode (Windows 10)</Bold> - separates the taskbar from the system tray so you can resize it by hand. It needs some setup; turn it on for instructions.
                    <LineBreak/>
                    <Bold>• Show this segment</Bold> - shows or hides the tray or widgets segment in dynamic mode. Press <Bold>Win+F2</Bold> at any time to toggle the tray.
                    <LineBreak/>
                    <Bold>• Show segments only when hovered</Bold> - shows the tray and widgets segments only while the mouse is over them. This uses more CPU.
                    <LineBreak/>
                    <Bold>• Restore the taskbar when a window is maximized</Bold> - turns the taskbar back to normal on a monitor with a maximized window.
                    <LineBreak/>
                    <Bold>• Restore the taskbar on alt+tab or win+tab (Windows 11)</Bold> - does the same while the task switcher is open.
                    <LineBreak/>
                    <Bold>• TranslucentTB compatibility</Bold> - lets ReRoundedTB work alongside TranslucentTB. It may flicker; turn it on for details.
                    <LineBreak/>
                    <Bold>• Auto-hide</Bold> - "Always hide" fades the taskbar out until the mouse reaches the bottom of the screen. This is ReRoundedTB's own auto-hide and is experimental.
                        </TextBlock>
                    </Grid>
                </Expander>
                <Expander x:Name="expander3" Header="Known issues" HorizontalAlignment="Center" VerticalAlignment="Top" Width="480" FontSize="16" FontFamily="Segoe UI Semibold">
                    <Grid>
                        <TextBlock Margin="0,5,0,0" x:Name="bodyBlock3" TextWrapping="Wrap" FontWeight="Normal" FontFamily="Segoe UI" FontSize="14" Opacity="0.8" LineHeight="23">
                    • Windows' own taskbar auto-hide setting isn't supported and can cause heavy flickering or an unreachable taskbar. Use ReRoundedTB's Auto-hide option instead.
                    <LineBreak/>
                    • Rounded corners aren't antialiased, due to a Windows limitation.
                    <LineBreak/>
                    • Dynamic mode and split mode only work when the taskbar is at the top or bottom of the screen.
                    <LineBreak/>
                    • Split mode only works on the primary monitor. Windows 10 support comes from RoundedTB and hasn't been tested in ReRoundedTB.
                    <LineBreak/>
                    • Taskbar mods other than TranslucentTB may conflict with ReRoundedTB.
                    <LineBreak/>
                    • In dynamic mode the taskbar can occasionally end up the wrong size. Opening or moving a window on that monitor usually corrects it.
                        </TextBlock>
                    </Grid>
                </Expander>
                <Expander x:Name="expander4" Header="Help and information" HorizontalAlignment="Center" VerticalAlignment="Top" Width="480" FontSize="16" FontFamily="Segoe UI Semibold">
                    <Grid>
                        <TextBlock Margin="0,5,0,0" x:Name="bodyBlock4" TextWrapping="Wrap" FontWeight="Normal" FontFamily="Segoe UI" FontSize="14" Opacity="0.8" LineHeight="21">
                    • Instructions, tips and troubleshooting are in the
                    <Hyperlink NavigateUri="https://github.com/RealCarvedArt/ReRoundedTB#readme" RequestNavigate="Hyperlink_RequestNavigate">README</Hyperlink>.
                    <LineBreak/>
                    • To browse the source code or download the latest release, visit
                    <Hyperlink NavigateUri="https://github.com/RealCarvedArt/ReRoundedTB" RequestNavigate="Hyperlink_RequestNavigate">the ReRoundedTB GitHub repository</Hyperlink>.
                    <LineBreak/>
                    <LineBreak/>
                    ReRoundedTB is a fork of <Hyperlink NavigateUri="https://github.com/torchgm/RoundedTB" RequestNavigate="Hyperlink_RequestNavigate">RoundedTB</Hyperlink> by torchgm. It is free software under the
                    <Hyperlink NavigateUri="https://github.com/RealCarvedArt/ReRoundedTB/blob/master/LICENSE" RequestNavigate="Hyperlink_RequestNavigate">GNU General Public License v3.0</Hyperlink>, and comes with no warranty.
                        </TextBlock>
                    </Grid>
                </Expander>
                <Expander x:Name="expander5" Header="Debug" HorizontalAlignment="Center" VerticalAlignment="Top" Width="480" FontSize="16" FontFamily="Segoe UI Semibold">
                    <StackPanel>
                        <Button x:Name="configButton" Content="Open settings file" Margin="0,10,0,0" Click="configButton_Click"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>


    </Grid>
</ui:FluentWindow>
