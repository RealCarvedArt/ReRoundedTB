<ui:FluentWindow x:Class="RoundedTB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoundedTB"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        mc:Ignorable="d"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Title="ReRoundedTB" Height="458" Width="718"
        Background="#20808080"
        d:Background="DarkGray"
        Visibility = "Visible"
        Opacity="0.001"
        d:Opacity="1"
        ResizeMode="NoResize"
        >
    <ui:FluentWindow.Resources>
        <!-- WPF-UI draws labels in its secondary text colour, which measured about 3:1 in light mode; use the primary text colour -->
        <Style TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
    </ui:FluentWindow.Resources>
    <!--169, 393-->
    <Grid x:Name="MainGrid" Margin="0,0,0,0" d:Margin="0,-16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="30" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="mainTitleBar" Grid.Row="0" Margin="0,0,0,0" Title="ReRoundedTB - Configuration" Height="51" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/RoundedTB.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <tray:NotifyIcon x:Name="trayIcon" Grid.Row="0" Icon="pack://application:,,,/res/traydark.ico" TooltipText="ReRoundedTB" FocusOnLeftClick="False" MenuOnRightClick="True" LeftClick="trayIcon_LeftClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem x:Name ="ShowMenuItem" Header="Show ReRoundedTB" Click="ShowMenuItem_Click"/>
                    <MenuItem x:Name="PauseMenuItem" Header="Pause (show the normal taskbar)" IsCheckable="True" Click="PauseMenuItem_Click"/>
                    <MenuItem x:Name="StartupMenuItem" Header="Run at startup" IsCheckable="True" Click="Startup_Clicked"/>
                    <MenuItem x:Name="ResetMenuItem" Header="Reset settings to defaults..." Click="ResetMenuItem_Click"/>
                    <Separator/>
                    <MenuItem x:Name ="CloseMenuItem" Header="Close ReRoundedTB" Click="CloseMenuItem_Click"/>
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <Grid Grid.Row="1">

            <!-- Tab order follows the layout: segment diagram, corner radius, margins, mode options, other options, auto-hide, Help, Apply.
                 TabIndex only orders siblings, so it is set on each group, not just on the controls inside. -->
            <Grid KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local" Margin="0,0,10,0" HorizontalAlignment="Right" Width="202" Height="55" VerticalAlignment="Top">
                <Label x:Name="cornerRadiusLabel" Content="Corner _radius" Target="{Binding ElementName=cornerRadiusInput}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBox x:Name="cornerRadiusInput" TabIndex="4" AutomationProperties.Name="Corner radius" AutomationProperties.HelpText="Pixels, 0 or more. The slider goes up to 48; type larger values here" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" HorizontalAlignment="Left" Width="94" Margin="108,19,0,0" LostFocus="cornerRadiusInput_LostFocus"/>
                <Slider x:Name="cornerRadiusSlider" TabIndex="5" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Width="84" LargeChange="4" SmallChange="1" Maximum="48" AutomationProperties.Name="Corner radius slider" Orientation="Horizontal" Thumb.DragCompleted="cornerRadiusSlider_DragCompleted" ValueChanged="cornerRadiusSlider_ValueChanged" Margin="0,18,0,0"/>
            </Grid>




            <ui:Button x:Name="aboutButton" TabIndex="9" Appearance="Secondary" Margin="0,0,10,47" VerticalAlignment="Bottom" Content="Help" Click="aboutButton_Click" FontWeight="Normal" HorizontalAlignment="Right" Width="133" Height="31"/>
            <ui:Button x:Name="applyButton" TabIndex="10" Appearance="Primary" Margin="0,0,10,10" VerticalAlignment="Bottom" Content="Apply" Click="ApplyButton_Click" FontWeight="Normal" HorizontalAlignment="Right" Width="133" Height="32"/>

            <CheckBox x:Name="dynamicCheckBox" TabIndex="4" Content="Dynamic mode" Margin="0,210,53,0" Checked="dynamicCheckBox_Checked" Unchecked="dynamicCheckBox_Unchecked" VerticalAlignment="Top" RenderTransformOrigin="1.763,4.069" Visibility="Visible" HorizontalAlignment="Right"/>
            <CheckBox x:Name="showTrayCheckBox" TabIndex="5" Content="Show this segment" Margin="0,210,44,0" VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="Hidden"/>
            <CheckBox x:Name="showWidgetsCheckBox" TabIndex="6" Content="Show this segment" Margin="0,210,44,0" VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="Hidden"/>

            <CheckBox x:Name="centredCheckBox" Content="Centred taskbar?" Margin="10,62,0,0" VerticalAlignment="Top" Visibility="Hidden"/>

            <Grid KeyboardNavigation.TabIndex="7" KeyboardNavigation.TabNavigation="Local" Width="555" Margin="15,0,0,4" HorizontalAlignment="Left" Height="124" VerticalAlignment="Bottom">
                <CheckBox x:Name="showSegmentsOnHoverCheckBox" TabIndex="13" Content="Show the tray and widgets only when the mouse is over them (uses more CPU)" Margin="0,0,0,0" VerticalAlignment="Top" Checked="showSegmentsOnHoverCheckBox_Checked" Unchecked="showSegmentsOnHoverCheckBox_Unchecked" HorizontalAlignment="Left" d:LayoutOverrides="HorizontalAlignment, VerticalAlignment"/>
                <CheckBox x:Name="fillMaximisedCheckBox" TabIndex="14" Content="When a window is maximised, restore the taskbar" Margin="0,30,0,0" Checked="fillMaximisedCheckBox_Checked"  Unchecked="fillMaximisedCheckBox_Unchecked"  VerticalAlignment="Top" HorizontalAlignment="Left" d:LayoutOverrides="HorizontalAlignment, VerticalAlignment"/>
                <CheckBox x:Name="fillAltTabCheckBox" TabIndex="15" Content="When alt+tab or win+tab is pressed, restore the taskbar" Margin="0,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" d:LayoutOverrides="HorizontalAlignment"/>
                <CheckBox x:Name="compositionFixCheckBox" TabIndex="16" Content="Improve compatibility with TranslucentTB and other mods (may cause flickering)" Margin="0,90,0,0" VerticalAlignment="Top" IsChecked="False" Checked="compositionFixCheckBox_Checked" HorizontalAlignment="Left" d:LayoutOverrides="HorizontalAlignment, VerticalAlignment"/>
            </Grid>

            <Grid KeyboardNavigation.TabIndex="3" KeyboardNavigation.TabNavigation="Local" Width="202" Height="110" Margin="0,70,10,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Label x:Name="mTopLabel" Content="_Top Margin" Target="{Binding ElementName=mTopInput}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="94" Margin="0,0,0,0" d:LayoutOverrides="HorizontalAlignment, VerticalAlignment"/>
                <TextBox x:Name="mTopInput" TabIndex="6" AutomationProperties.Name="Top margin" AutomationProperties.HelpText="Pixels; negative values attach the taskbar to that edge" HorizontalAlignment="Left" Margin="0,20,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" Width="94" d:LayoutOverrides="HorizontalAlignment, VerticalAlignment" LostFocus="mTopInput_LostFocus"/>

                <Label x:Name="mBottomLabel" Content="_Bottom Margin" Target="{Binding ElementName=mBottomInput}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="108,0,0,0" Width="94" d:LayoutOverrides="HorizontalAlignment, VerticalAlignment"/>
                <TextBox x:Name="mBottomInput" TabIndex="7" AutomationProperties.Name="Bottom margin" AutomationProperties.HelpText="Pixels; negative values attach the taskbar to that edge" HorizontalAlignment="Left" Margin="108,20,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" Width="94" d:LayoutOverrides="VerticalAlignment" LostFocus="mBottomInput_LostFocus"/>

                <Label x:Name="mLeftLabel" Content="_Left Margin" Target="{Binding ElementName=mLeftInput}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,56,0,0" Width="94" d:LayoutOverrides="HorizontalAlignment"/>
                <TextBox x:Name="mLeftInput" TabIndex="8" AutomationProperties.Name="Left margin" AutomationProperties.HelpText="Pixels; negative values attach the taskbar to that edge" HorizontalAlignment="Left" Margin="0,76,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" Width="94" d:LayoutOverrides="HorizontalAlignment" LostFocus="mLeftInput_LostFocus"/>

                <Label x:Name="mRightLabel" Content="R_ight Margin" Target="{Binding ElementName=mRightInput}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="108,56,0,0" Width="84"/>
                <TextBox x:Name="mRightInput" TabIndex="9" AutomationProperties.Name="Right margin" AutomationProperties.HelpText="Pixels; negative values attach the taskbar to that edge" HorizontalAlignment="Left" Margin="108,76,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" Width="94" LostFocus="mRightInput_LostFocus"/>

            </Grid>

            <Grid x:Name="tbDiagramGrid" KeyboardNavigation.TabIndex="1" KeyboardNavigation.TabNavigation="Local" Margin="10,0,0,0" Height="247" VerticalAlignment="Top" HorizontalAlignment="Left" Width="486">
                <Rectangle Stroke="#30242424" Fill="#20808080" RadiusX="5" RadiusY="5"/>
                <ui:Button x:Name="taskbarRectStandIn" TabIndex="2" HorizontalAlignment="Stretch" Margin="126,0,126,5" VerticalAlignment="Bottom" Click="taskbarRectStandIn_Click" Appearance="Primary" Height="32"/>
                <ui:Button x:Name="trayRectStandIn" TabIndex="3" HorizontalAlignment="Stretch" Margin="415,0,5,5" Click="trayRectStandIn_Click" VerticalAlignment="Bottom" Height="32" Padding="2,0,2,0" Appearance="Secondary"/>
                <ui:Button x:Name="widgetsRectStandIn" TabIndex="1" HorizontalAlignment="Stretch" Margin="5,0,415,5" Click="widgetsRectStandIn_Click" VerticalAlignment="Bottom" Height="32" Padding="2,0,2,0" Appearance="Secondary"/>

                <Label x:Name="headingLabel" Content="ReRoundedTB" HorizontalAlignment="Center" Margin="0,59,0,108" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" FontSize="60" Opacity="0.75"/>
                <Label x:Name="beginLabel" Content="To begin, select a taskbar segment below." HorizontalAlignment="Center" Margin="0,138,0,75" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" FontSize="20" Opacity="0.75"/>
                <!-- Windows 10 split mode only: a visible, focusable way back to the setup steps (it used to be an invisible click target) -->
                <ui:Button x:Name="splitHelpButton" TabIndex="0" Appearance="Secondary" Content="Split mode help" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,175,0,0" Height="30" Padding="12,0,12,0" FontWeight="Normal" Click="splitHelpButton_Click" Visibility="Hidden"/>
            </Grid>

            <Grid KeyboardNavigation.TabIndex="8" KeyboardNavigation.TabNavigation="Local" Margin="0,0,10,83" HorizontalAlignment="Right" Width="133" Height="58" VerticalAlignment="Bottom">
                <Label Content="Auto-_hide" Target="{Binding ElementName=autoHideComboBox}" Height="20" VerticalAlignment="Top"/>
                <ComboBox x:Name="autoHideComboBox" TabIndex="17" AutomationProperties.Name="Auto-hide" Margin="0,18,0,0" VerticalAlignment="Top">
                    <ComboBoxItem>Always show</ComboBoxItem>
                    <ComboBoxItem>Always hide</ComboBoxItem>
                    <ComboBoxItem IsEnabled="False">[unavailable]</ComboBoxItem>
                </ComboBox>
            </Grid>
            <Rectangle HorizontalAlignment="Center" Margin="0,262,0,0" Stroke="#4C909090" Width="698" RadiusX="1" RadiusY="1.5" Height="1" VerticalAlignment="Top"/>

        </Grid>
    </Grid>
</ui:FluentWindow>
